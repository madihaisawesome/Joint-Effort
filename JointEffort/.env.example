# Auth0 SPA. Copy this file to .env and fill in the values from your Auth0 application.
# Application type: Single Page Application.
# Allowed callback, logout, and web origin: http://localhost:5173
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=

# Optional. Leave blank in local dev — Vite proxies /api to http://localhost:3000.
# Set this only if the API is hosted elsewhere.
# VITE_API_BASE=http://localhost:3000
